<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="People6133261.MainPage">

    <ScrollView>
        <VerticalStackLayout 
            Spacing="15"
            Padding="20">

            <Label Text="Name:" />
            <Entry x:Name="NameEntry" Placeholder="Enter a name" />

            <Button 
                Text="Add Person"
                Clicked="OnAddPersonClicked" />

            <Button 
                Text="Get All People"
                Clicked="OnGetAllPeopleClicked" />

            <Label x:Name="StatusLabel" />

            <ListView x:Name="PeopleListView">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
